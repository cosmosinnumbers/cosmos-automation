{
  "mcpServers": {
    "jev": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@french-castle/jev-code@0.5.0",
        "mcp"
      ],
      "env": {
        "NODE_USE_ENV_PROXY": "1",
        "NODE_NO_WARNINGS": "1",
        "TYPESAFE_API_KEY": "${TYPESAFE_API_KEY:-proxy-injected}"
      }
    }
  }
}
